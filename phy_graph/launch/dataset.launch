<launch>
    <!-- Argument to select the label space -->
    <arg name="label_space" default="uhuman2" />

    <!-- Topic arguments for flexible configuration -->
    <arg name="rgb_topic" default="/tesse/left_cam/rgb/image_raw" />
    <arg name="camera_info_topic" default="/tesse/left_cam/camera_info" />
    <arg name="depth_topic" default="/tesse/depth_cam/mono/image_raw" />
    <arg name="mesh_topic" default="/hydra_dsg_visualizer/dsg_mesh" />
    <arg name="debug_save_images" default="true" />
    <!-- Inference configuration file -->
    <arg name="inference_config" default="$(find phy_graph)/config/inference_config.yaml" />
    <!-- Start the Python service for physical property inference -->
    <node name="phy_graph_server"
          pkg="phy_graph"
          type="module.py"
          output="screen">
    </node>

    <!-- Start the C++ node for subscribing to Hydra's output -->
    <node name="phy_graph_node"
          pkg="phy_graph"
          type="phy_graph_node"
          output="screen">
        <!-- Remap topics to use arguments for flexibility -->
        <remap from="input_mesh" to="$(arg mesh_topic)" />
        <remap from="rgb_image" to="$(arg rgb_topic)" />
        <remap from="camera_info" to="$(arg camera_info_topic)" />
        <remap from="depth_image" to="$(arg depth_topic)" />
        <rosparam command="load" file="$(arg inference_config)" ns="inference" />
        <!-- Load parameters into the node's private namespace -->
        <rosparam command="load" file="$(find phy_graph)/config/label_spaces/$(arg label_space).yaml" />
        <param name="label_space" value="$(arg label_space)" />
        <param name="/use_sim_time" value="true"/>
    </node>
    
    <!-- 3. Start the Graph Generator Node (The "Integrator") -->
    <!-- This node reads the JSONs from step 2 and the DSG, then builds the enhanced graph -->
    <node name="graph_generator_node" 
          pkg="phy_graph" 
          type="graph_generator_node" 
          output="screen">
    </node>
</launch>
